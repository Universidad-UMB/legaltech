<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_NOV" targetNamespace="https://grado.legaltech.edu/tobe/0.2" exporter="TOBE-001 Engineering Analysis" exporterVersion="0.2">
  <bpmn:process id="Process_NOV" name="SP-04/05/06 Revisión de novedades y publicación" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NOV">
      <bpmn:lane id="Lane_NOV_Analista" name="Analista">
        <bpmn:flowNodeRef>NOV_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_discard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_enddiscard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_legal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_objective</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NOV_Sistema" name="Sistema">
        <bpmn:flowNodeRef>NOV_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_processed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NOV_Abogado" name="Abogado">
        <bpmn:flowNodeRef>NOV_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_sufficient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_endpending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NOV_Coordinador" name="Coordinador">
        <bpmn:flowNodeRef>NOV_authorize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOV_endreject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NOV_start" name="Novedad pendiente de revisión"/>
    <bpmn:userTask id="NOV_inspect" name="Revisar evidencia y cambio"/>
    <bpmn:exclusiveGateway id="NOV_confirmed" name="¿Cambio confirmado?"/>
    <bpmn:userTask id="NOV_discard" name="Descartar con justificación"/>
    <bpmn:endEvent id="NOV_enddiscard" name="Novedad descartada"/>
    <bpmn:exclusiveGateway id="NOV_legal" name="¿Requiere revisión jurídica?"/>
    <bpmn:userTask id="NOV_objective" name="Preparar contenido objetivo"/>
    <bpmn:exclusiveGateway id="NOV_doc" name="¿Hay documento procesable?"/>
    <bpmn:serviceTask id="NOV_extract" name="Extraer texto y proponer campos si autorizado">
      <bpmn:documentation>El resultado LLM no sustituye validación jurídica. Ante falla se continúa manualmente.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NOV_processed" name="¿Extracción utilizable?"/>
    <bpmn:serviceTask id="NOV_failure" name="Conservar error y habilitar revisión manual"/>
    <bpmn:userTask id="NOV_review" name="Revisar y validar evidencia"/>
    <bpmn:exclusiveGateway id="NOV_sufficient" name="¿Revisión concluida?"/>
    <bpmn:userTask id="NOV_pending" name="Solicitar información adicional"/>
    <bpmn:endEvent id="NOV_endpending" name="Revisión pendiente"/>
    <bpmn:userTask id="NOV_prepare" name="Preparar propuesta comunicable"/>
    <bpmn:userTask id="NOV_authorize" name="Evaluar autorización de publicación"/>
    <bpmn:exclusiveGateway id="NOV_approved" name="¿Publicación autorizada?"/>
    <bpmn:userTask id="NOV_reject" name="Registrar rechazo y motivo"/>
    <bpmn:endEvent id="NOV_endreject" name="Publicación no autorizada"/>
    <bpmn:serviceTask id="NOV_publish" name="Versionar y publicar para cliente"/>
    <bpmn:endEvent id="NOV_end" name="Publicado para destinatarios autorizados"/>
    <bpmn:sequenceFlow id="NOV_Flow_01" sourceRef="NOV_start" targetRef="NOV_inspect"/>
    <bpmn:sequenceFlow id="NOV_Flow_02" sourceRef="NOV_inspect" targetRef="NOV_confirmed"/>
    <bpmn:sequenceFlow id="NOV_Flow_03" sourceRef="NOV_confirmed" targetRef="NOV_discard" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_04" sourceRef="NOV_discard" targetRef="NOV_enddiscard"/>
    <bpmn:sequenceFlow id="NOV_Flow_05" sourceRef="NOV_confirmed" targetRef="NOV_legal" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_06" sourceRef="NOV_legal" targetRef="NOV_objective" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_07" sourceRef="NOV_objective" targetRef="NOV_authorize"/>
    <bpmn:sequenceFlow id="NOV_Flow_08" sourceRef="NOV_legal" targetRef="NOV_doc" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_09" sourceRef="NOV_doc" targetRef="NOV_extract" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_10" sourceRef="NOV_doc" targetRef="NOV_review" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_11" sourceRef="NOV_extract" targetRef="NOV_processed"/>
    <bpmn:sequenceFlow id="NOV_Flow_12" sourceRef="NOV_processed" targetRef="NOV_review" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_13" sourceRef="NOV_processed" targetRef="NOV_failure" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_14" sourceRef="NOV_failure" targetRef="NOV_review"/>
    <bpmn:sequenceFlow id="NOV_Flow_15" sourceRef="NOV_review" targetRef="NOV_sufficient"/>
    <bpmn:sequenceFlow id="NOV_Flow_16" sourceRef="NOV_sufficient" targetRef="NOV_pending" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_17" sourceRef="NOV_pending" targetRef="NOV_endpending"/>
    <bpmn:sequenceFlow id="NOV_Flow_18" sourceRef="NOV_sufficient" targetRef="NOV_prepare" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_19" sourceRef="NOV_prepare" targetRef="NOV_authorize"/>
    <bpmn:sequenceFlow id="NOV_Flow_20" sourceRef="NOV_authorize" targetRef="NOV_approved"/>
    <bpmn:sequenceFlow id="NOV_Flow_21" sourceRef="NOV_approved" targetRef="NOV_reject" name="No"/>
    <bpmn:sequenceFlow id="NOV_Flow_22" sourceRef="NOV_reject" targetRef="NOV_endreject"/>
    <bpmn:sequenceFlow id="NOV_Flow_23" sourceRef="NOV_approved" targetRef="NOV_publish" name="Sí"/>
    <bpmn:sequenceFlow id="NOV_Flow_24" sourceRef="NOV_publish" targetRef="NOV_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_NOV">
    <bpmn:participant id="Participant_Operator_NOV" name="Organización jurídica operadora" processRef="Process_NOV"/>
    <bpmn:participant id="Participant_NOV_Proveedor_LLM" name="Proveedor LLM"/>
    <bpmn:messageFlow id="NOV_Message_01" name="Solicitud procesamiento autorizado" sourceRef="NOV_extract" targetRef="Participant_NOV_Proveedor_LLM"/>
    <bpmn:messageFlow id="NOV_Message_02" name="Propuesta estructurada" sourceRef="Participant_NOV_Proveedor_LLM" targetRef="NOV_extract"/>
  </bpmn:collaboration>
