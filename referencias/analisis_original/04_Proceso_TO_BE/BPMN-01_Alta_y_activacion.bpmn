<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_ALTA" targetNamespace="https://grado.legaltech.edu/tobe/0.2" exporter="TOBE-001 Engineering Analysis" exporterVersion="0.2">
  <bpmn:process id="Process_ALTA" name="SP-01 Alta de clientes y seguimientos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ALTA">
      <bpmn:lane id="Lane_ALTA_Coordinador" name="Coordinador">
        <bpmn:flowNodeRef>ALTA_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_client</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_reuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ALTA_Administrador" name="Administrador">
        <bpmn:flowNodeRef>ALTA_provision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ALTA_Analista" name="Analista">
        <bpmn:flowNodeRef>ALTA_rad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_rect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ALTA_Sistema" name="Sistema">
        <bpmn:flowNodeRef>ALTA_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_gwvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_enddup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_enabled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_active</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALTA_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ALTA_start" name="Solicitud de seguimiento">
      <bpmn:documentation>La solicitud de una cartera proviene de un interesado legitimado.</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ALTA_client" name="¿Cliente existe?"/>
    <bpmn:userTask id="ALTA_new" name="Registrar cliente"/>
    <bpmn:userTask id="ALTA_reuse" name="Seleccionar cliente"/>
    <bpmn:userTask id="ALTA_rad" name="Registrar radicado"/>
    <bpmn:serviceTask id="ALTA_validate" name="Validar identidad y formato">
      <bpmn:documentation>Valida radicado según reglas y contexto judicial; no inventa un proceso inexistente.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ALTA_gwvalid" name="¿Datos válidos?"/>
    <bpmn:userTask id="ALTA_rect" name="Corregir registro"/>
    <bpmn:exclusiveGateway id="ALTA_exists" name="¿Seguimiento ya existe?"/>
    <bpmn:endEvent id="ALTA_enddup" name="Informar seguimiento existente"/>
    <bpmn:userTask id="ALTA_create" name="Crear relación cliente-proceso"/>
    <bpmn:userTask id="ALTA_assign" name="Asignar responsable y política"/>
    <bpmn:exclusiveGateway id="ALTA_accounts" name="¿Se necesitan cuentas externas?"/>
    <bpmn:userTask id="ALTA_provision" name="Habilitar cuentas autorizadas"/>
    <bpmn:exclusiveGateway id="ALTA_enabled" name="¿Fuente habilitada?"/>
    <bpmn:serviceTask id="ALTA_active" name="Activar seguimiento"/>
    <bpmn:serviceTask id="ALTA_pending" name="Registrar pendiente de adquisición"/>
    <bpmn:endEvent id="ALTA_end" name="Seguimiento preparado"/>
    <bpmn:sequenceFlow id="ALTA_Flow_01" sourceRef="ALTA_start" targetRef="ALTA_client"/>
    <bpmn:sequenceFlow id="ALTA_Flow_02" sourceRef="ALTA_client" targetRef="ALTA_new" name="No"/>
    <bpmn:sequenceFlow id="ALTA_Flow_03" sourceRef="ALTA_client" targetRef="ALTA_reuse" name="Sí"/>
    <bpmn:sequenceFlow id="ALTA_Flow_04" sourceRef="ALTA_new" targetRef="ALTA_rad"/>
    <bpmn:sequenceFlow id="ALTA_Flow_05" sourceRef="ALTA_reuse" targetRef="ALTA_rad"/>
    <bpmn:sequenceFlow id="ALTA_Flow_06" sourceRef="ALTA_rad" targetRef="ALTA_validate"/>
    <bpmn:sequenceFlow id="ALTA_Flow_07" sourceRef="ALTA_validate" targetRef="ALTA_gwvalid"/>
    <bpmn:sequenceFlow id="ALTA_Flow_08" sourceRef="ALTA_gwvalid" targetRef="ALTA_rect" name="No"/>
    <bpmn:sequenceFlow id="ALTA_Flow_09" sourceRef="ALTA_rect" targetRef="ALTA_rad"/>
    <bpmn:sequenceFlow id="ALTA_Flow_10" sourceRef="ALTA_gwvalid" targetRef="ALTA_exists" name="Sí"/>
    <bpmn:sequenceFlow id="ALTA_Flow_11" sourceRef="ALTA_exists" targetRef="ALTA_enddup" name="Sí"/>
    <bpmn:sequenceFlow id="ALTA_Flow_12" sourceRef="ALTA_exists" targetRef="ALTA_create" name="No"/>
    <bpmn:sequenceFlow id="ALTA_Flow_13" sourceRef="ALTA_create" targetRef="ALTA_assign"/>
    <bpmn:sequenceFlow id="ALTA_Flow_14" sourceRef="ALTA_assign" targetRef="ALTA_accounts"/>
    <bpmn:sequenceFlow id="ALTA_Flow_15" sourceRef="ALTA_accounts" targetRef="ALTA_provision" name="Sí"/>
    <bpmn:sequenceFlow id="ALTA_Flow_16" sourceRef="ALTA_provision" targetRef="ALTA_enabled"/>
    <bpmn:sequenceFlow id="ALTA_Flow_17" sourceRef="ALTA_accounts" targetRef="ALTA_enabled" name="No"/>
    <bpmn:sequenceFlow id="ALTA_Flow_18" sourceRef="ALTA_enabled" targetRef="ALTA_active" name="Sí"/>
    <bpmn:sequenceFlow id="ALTA_Flow_19" sourceRef="ALTA_enabled" targetRef="ALTA_pending" name="No"/>
    <bpmn:sequenceFlow id="ALTA_Flow_20" sourceRef="ALTA_active" targetRef="ALTA_end"/>
    <bpmn:sequenceFlow id="ALTA_Flow_21" sourceRef="ALTA_pending" targetRef="ALTA_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_ALTA">
    <bpmn:participant id="Participant_Operator_ALTA" name="Organización jurídica operadora" processRef="Process_ALTA"/>
    <bpmn:participant id="Participant_ALTA_Cliente_externo" name="Cliente externo"/>
    <bpmn:messageFlow id="ALTA_Message_01" name="Solicitud de vigilancia" sourceRef="Participant_ALTA_Cliente_externo" targetRef="ALTA_start"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ALTA" name="SP-01 Alta de clientes y seguimientos">
