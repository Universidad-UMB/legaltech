<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_PORTAL" targetNamespace="https://grado.legaltech.edu/tobe/0.2" exporter="TOBE-001 Engineering Analysis" exporterVersion="0.2">
  <bpmn:process id="Process_PORTAL" name="SP-07 Acceso de cliente y consulta de resultados" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PORTAL">
      <bpmn:lane id="Lane_PORTAL_Sistema___Autenticación" name="Sistema - Autenticación">
        <bpmn:flowNodeRef>PORTAL_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_gw_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_deny_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_endloginbad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_endlogin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PORTAL_Sistema___Consulta_autorizada" name="Sistema - Consulta autorizada">
        <bpmn:flowNodeRef>PORTAL_resource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_gw_resource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_enddeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_get</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PORTAL_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PORTAL_login" name="Solicitud de autenticación">
      <bpmn:messageEventDefinition id="Message_PORTAL_login"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PORTAL_auth" name="Validar credenciales y estado"/>
    <bpmn:exclusiveGateway id="PORTAL_gw_auth" name="¿Autenticación válida?"/>
    <bpmn:serviceTask id="PORTAL_deny_login" name="Denegar acceso y registrar evento"/>
    <bpmn:endEvent id="PORTAL_endloginbad" name="Acceso denegado"/>
    <bpmn:serviceTask id="PORTAL_session" name="Emitir sesión autorizada"/>
    <bpmn:endEvent id="PORTAL_endlogin" name="Sesión establecida"/>
    <bpmn:startEvent id="PORTAL_resource" name="Solicitud de consulta autenticada">
      <bpmn:messageEventDefinition id="Message_PORTAL_resource"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PORTAL_check" name="Validar sesión y autorización del recurso"/>
    <bpmn:exclusiveGateway id="PORTAL_gw_resource" name="¿Acceso permitido?"/>
    <bpmn:serviceTask id="PORTAL_deny" name="Denegar recurso y auditar"/>
    <bpmn:endEvent id="PORTAL_enddeny" name="Consulta denegada"/>
    <bpmn:serviceTask id="PORTAL_get" name="Obtener solo información publicada"/>
    <bpmn:serviceTask id="PORTAL_show" name="Entregar resultado y registrar acceso"/>
    <bpmn:endEvent id="PORTAL_end" name="Consulta completada"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_01" sourceRef="PORTAL_login" targetRef="PORTAL_auth"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_02" sourceRef="PORTAL_auth" targetRef="PORTAL_gw_auth"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_03" sourceRef="PORTAL_gw_auth" targetRef="PORTAL_deny_login" name="No"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_04" sourceRef="PORTAL_deny_login" targetRef="PORTAL_endloginbad"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_05" sourceRef="PORTAL_gw_auth" targetRef="PORTAL_session" name="Sí"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_06" sourceRef="PORTAL_session" targetRef="PORTAL_endlogin"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_07" sourceRef="PORTAL_resource" targetRef="PORTAL_check"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_08" sourceRef="PORTAL_check" targetRef="PORTAL_gw_resource"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_09" sourceRef="PORTAL_gw_resource" targetRef="PORTAL_deny" name="No"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_10" sourceRef="PORTAL_deny" targetRef="PORTAL_enddeny"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_11" sourceRef="PORTAL_gw_resource" targetRef="PORTAL_get" name="Sí"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_12" sourceRef="PORTAL_get" targetRef="PORTAL_show"/>
    <bpmn:sequenceFlow id="PORTAL_Flow_13" sourceRef="PORTAL_show" targetRef="PORTAL_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_PORTAL">
    <bpmn:participant id="Participant_Operator_PORTAL" name="Organización jurídica operadora" processRef="Process_PORTAL"/>
    <bpmn:participant id="Participant_PORTAL_Cliente_externo" name="Cliente externo"/>
    <bpmn:messageFlow id="PORTAL_Message_01" name="Credenciales" sourceRef="Participant_PORTAL_Cliente_externo" targetRef="PORTAL_login"/>
    <bpmn:messageFlow id="PORTAL_Message_02" name="Resultado de inicio de sesión" sourceRef="PORTAL_session" targetRef="Participant_PORTAL_Cliente_externo"/>
    <bpmn:messageFlow id="PORTAL_Message_03" name="Solicitud de recurso" sourceRef="Participant_PORTAL_Cliente_externo" targetRef="PORTAL_resource"/>
    <bpmn:messageFlow id="PORTAL_Message_04" name="Resultado autorizado" sourceRef="PORTAL_show" targetRef="Participant_PORTAL_Cliente_externo"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PORTAL" name="SP-07 Acceso de cliente y consulta de resultados">
